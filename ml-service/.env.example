# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/mega
# For Docker Compose MongoDB (uncomment and update):
# MONGODB_URI=mongodb://megaadmin:megapassword@localhost:27017/mega?authSource=admin

# ─── Storage ──────────────────────────────────────────────────────────────────
# Path to the video storage directory (shared with backend)
VIDEO_STORAGE_PATH=../backend/storage/videos

# Path where FAISS indices are saved
FAISS_INDEX_PATH=./faiss

# ─── Models ───────────────────────────────────────────────────────────────────
# CLIP model name — options: ViT-B-32, ViT-L-14
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai

# Whisper model size — options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base
# Optional MLX model repo/path; blank uses the matching model size
WHISPER_MLX_MODEL=

# Optional exported PP-OCRv6 detector directory (must contain inference.onnx).
# When set on Apple Silicon, Core ML is tried first, then ONNX CPU, then Paddle.
OCR_DETECTOR_ONNX_DIR=
# Reuse only byte-identical frame files within a video; 0 disables caching.
OCR_EXACT_CACHE_MB=16
# Reload the same Whisper weights for each video to reduce OCR memory pressure.
RELEASE_WHISPER_AFTER_TRANSCRIPTION=true

# LLM for query expansion — options: local (flan-t5-base), openai
QUERY_EXPANSION_MODE=local

# OpenAI API key (only needed if QUERY_EXPANSION_MODE=openai)
OPENAI_API_KEY=

# ─── GPU ──────────────────────────────────────────────────────────────────────
# Prefer NVIDIA CUDA, then Apple MPS for CLIP, otherwise CPU.
# Whisper uses MLX on Apple Silicon or PyTorch CUDA/CPU elsewhere.
# Set true to force all models onto CPU.
FORCE_CPU=false

# Indexing speed: preserve chunk timing and visual sampling, batch GPU work
INDEXING_BATCH_SIZE=8
CLIP_BATCH_SIZE=32

CHUNK_SIZE_SECONDS=7
CHUNK_OVERLAP_SECONDS=3
FRAMES_PER_CHUNK=4
