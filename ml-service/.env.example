# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/mega
# For Docker Compose MongoDB (uncomment and update):
# MONGODB_URI=mongodb://megaadmin:megapassword@localhost:27017/mega?authSource=admin

# ─── Storage ──────────────────────────────────────────────────────────────────
# Path to the video storage directory (shared with backend)
VIDEO_STORAGE_PATH=../backend/storage/videos

# Path where FAISS indices are saved
FAISS_INDEX_PATH=./faiss

# ─── Models ───────────────────────────────────────────────────────────────────
# CLIP model name — options: ViT-B-32, ViT-L-14
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai

# Whisper model size — options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# LLM for query expansion — options: local (flan-t5-base), openai
QUERY_EXPANSION_MODE=local

# OpenAI API key (only needed if QUERY_EXPANSION_MODE=openai)
OPENAI_API_KEY=

# ─── GPU ──────────────────────────────────────────────────────────────────────
# Set to true to force CPU even if CUDA is available
FORCE_CPU=false
