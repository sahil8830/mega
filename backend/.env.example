# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/mega
# Docker Compose MongoDB (uncomment and update):
# MONGODB_URI=mongodb://megaadmin:megapassword@localhost:27017/mega?authSource=admin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # Uncomment if your Redis instance has a password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ─── File Upload ──────────────────────────────────────────────────────────────
VIDEO_STORAGE_PATH=./storage/videos
MAX_FILE_SIZE_MB=500
